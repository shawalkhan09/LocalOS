# Postgres connection string.
DATABASE_URL=postgres://localhost:5432/localos

# Exact origin of apps/web — required once cookies are in play, since a
# wildcard CORS origin can't be combined with credentialed requests.
ALLOWED_ORIGIN=http://localhost:3001

# Only used on first boot, when the users table is empty: creates the
# owner account. Leave unset after that — bootstrap is a no-op once any
# user exists.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me
